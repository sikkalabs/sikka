# Local Tor mesh test seeds: 32-byte hex (64 chars) each, one per validator.
#
#   cp .env.example .env
#   ./docker/test-tor-mesh.sh
#
# Generate fresh ones (do NOT reuse these placeholders beyond smoke tests):
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
validator1=1111111111111111111111111111111111111111111111111111111111111111
validator2=2222222222222222222222222222222222222222222222222222222222222222
# Log level for both validators (trace|debug|info|warn|error).
SIKKA_LOG=info
